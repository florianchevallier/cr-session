# App runtime
GOOGLE_API_KEY=your_google_api_key
PORT=3001

# Gemini model overrides (optional — per-task granularity)
# Each task checks: GEMINI_MODEL_{TASK} → GEMINI_MODEL_{PRO|FLASH} → hardcoded default
#
# Per-task overrides:
# GEMINI_MODEL_ANALYST=gemini-2.5-flash-preview-05-20
# GEMINI_MODEL_SUMMARIZER=gemini-2.5-flash-preview-05-20
# GEMINI_MODEL_VALIDATOR=gemini-2.0-flash-lite
# GEMINI_MODEL_CORRECTION=gemini-2.5-flash-preview-05-20
#
# Group overrides (fallback if per-task not set):
# GEMINI_MODEL_PRO=gemini-2.5-flash-preview-05-20
# GEMINI_MODEL_FLASH=gemini-2.0-flash-lite

# Optional for docker-compose.prod.yml (Traefik host rule)
TRAEFIK_HOST=cr-session.example.com
